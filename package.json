{
  "name": "tailor-executive-ai-notes",
  "private": true,
  "version": "0.20.9",
  "author": "Tailor Executive",
  "type": "module",
  "description": "Tailor Executive AI Notes - IA de anotacoes e transcricoes de reunioes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "preelectron:dev": "node electron/build-icon.mjs",
    "electron:dev": "electron .",
    "electron:icon": "node electron/build-icon.mjs",
    "predist:win": "node electron/build-icon.mjs && node electron/patch-nsis.mjs",
    "dist:win": "electron-builder --win",
    "prerelease:win": "node electron/build-icon.mjs && node electron/patch-nsis.mjs && node electron/ensure-release.mjs",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^3.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "build": {
    "appId": "br.com.tailorexec.tena.desktop",
    "productName": "ANA by Tailor",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "build/icon.ico",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ANA-by-Tailor-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "tailorexec",
      "repo": "tailor-executive-ai-notes",
      "releaseType": "release"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US",
      "es",
      "es-419"
    ]
  }
}
